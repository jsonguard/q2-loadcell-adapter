{
  "pythonVersion": "3.9",
  "venvPath": ".",
  "venv": ".venv",
  "stubPath": "vendor/stubs",
  "extraPaths": ["src", "tests"],
  "exclude": [
    ".venv",
    "vendor/klipper-src",
    "vendor/stubs",
    "**/__pycache__",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache"
  ],
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": "none"
}
