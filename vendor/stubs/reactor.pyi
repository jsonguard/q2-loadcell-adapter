import greenlet
from _typeshed import Incomplete

_NOW: float
_NEVER: float

class ReactorTimer:
    callback: Incomplete
    waketime: Incomplete
    def __init__(self, callback, waketime) -> None: ...

class ReactorCompletion:
    class sentinel: ...
    reactor: Incomplete
    result: Incomplete
    waiting: Incomplete
    def __init__(self, reactor) -> None: ...
    def test(self): ...
    def complete(self, result) -> None: ...
    def wait(self, waketime=..., waketime_result=None): ...

class ReactorCallback:
    reactor: Incomplete
    timer: Incomplete
    callback: Incomplete
    completion: Incomplete
    def __init__(self, reactor, callback, waketime) -> None: ...
    def invoke(self, eventtime): ...

class ReactorFileHandler:
    fd: Incomplete
    read_callback: Incomplete
    write_callback: Incomplete
    def __init__(self, fd, read_callback, write_callback) -> None: ...
    def fileno(self): ...

class ReactorGreenlet(greenlet.greenlet):
    timer: Incomplete
    def __init__(self, run) -> None: ...

class ReactorMutex:
    reactor: Incomplete
    is_locked: Incomplete
    next_pending: bool
    queue: Incomplete
    lock: Incomplete
    unlock: Incomplete
    def __init__(self, reactor, is_locked) -> None: ...
    def test(self): ...
    def __enter__(self) -> None: ...
    def __exit__(self, type=None, value=None, tb=None) -> None: ...

class SelectReactor:
    NOW = _NOW
    NEVER = _NEVER
    _process: bool
    monotonic: Incomplete
    _check_gc: Incomplete
    _last_gc_times: Incomplete
    _timers: Incomplete
    _next_timer: Incomplete
    _pipe_fds: Incomplete
    _async_queue: Incomplete
    _read_fds: Incomplete
    _write_fds: Incomplete
    _g_dispatch: Incomplete
    _greenlets: Incomplete
    _all_greenlets: Incomplete
    def __init__(self, gc_checking: bool = False) -> None: ...
    def get_gc_stats(self): ...
    def update_timer(self, timer_handler, waketime) -> None: ...
    def register_timer(self, callback, waketime=...): ...
    def unregister_timer(self, timer_handler) -> None: ...
    def _check_timers(self, eventtime, busy): ...
    def completion(self): ...
    def register_callback(self, callback, waketime=...): ...
    def register_async_callback(self, callback, waketime=...) -> None: ...
    def async_complete(self, completion, result) -> None: ...
    def _got_pipe_signal(self, eventtime) -> None: ...
    def _setup_async_callbacks(self) -> None: ...
    def _sys_pause(self, waketime): ...
    def pause(self, waketime): ...
    def _end_greenlet(self, g_old) -> None: ...
    def mutex(self, is_locked: bool = False): ...
    def register_fd(self, fd, read_callback, write_callback=None): ...
    def unregister_fd(self, file_handler) -> None: ...
    def set_fd_wake(self, file_handler, is_readable: bool = True, is_writeable: bool = False) -> None: ...
    def _dispatch_loop(self) -> None: ...
    def run(self) -> None: ...
    def end(self) -> None: ...
    def finalize(self) -> None: ...

class PollReactor(SelectReactor):
    _poll: Incomplete
    _fds: Incomplete
    def __init__(self, gc_checking: bool = False) -> None: ...
    def register_fd(self, fd, read_callback, write_callback=None): ...
    def unregister_fd(self, file_handler) -> None: ...
    def set_fd_wake(self, file_handler, is_readable: bool = True, is_writeable: bool = False) -> None: ...
    _g_dispatch: Incomplete
    def _dispatch_loop(self) -> None: ...

class EPollReactor(SelectReactor):
    _epoll: Incomplete
    _fds: Incomplete
    def __init__(self, gc_checking: bool = False) -> None: ...
    def register_fd(self, fd, read_callback, write_callback=None): ...
    def unregister_fd(self, file_handler) -> None: ...
    def set_fd_wake(self, file_handler, is_readable: bool = True, is_writeable: bool = False) -> None: ...
    _g_dispatch: Incomplete
    def _dispatch_loop(self) -> None: ...
Reactor = PollReactor
Reactor = SelectReactor
