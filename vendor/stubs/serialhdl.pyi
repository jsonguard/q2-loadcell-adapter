from _typeshed import Incomplete

class error(Exception): ...

class SerialReader:
    reactor: Incomplete
    warn_prefix: Incomplete
    serial_dev: Incomplete
    msgparser: Incomplete
    serialqueue: Incomplete
    default_cmd_queue: Incomplete
    stats_buf: Incomplete
    lock: Incomplete
    background_thread: Incomplete
    handlers: Incomplete
    last_notify_id: int
    pending_notifications: Incomplete
    def __init__(self, reactor, warn_prefix: str = '') -> None: ...
    def _bg_thread(self) -> None: ...
    def _error(self, msg, *params) -> None: ...
    def _get_identify_data(self, eventtime): ...
    def _start_session(self, serial_dev, serial_fd_type: bytes = b'u', client_id: int = 0): ...
    def connect_canbus(self, canbus_uuid, canbus_nodeid, canbus_iface: str = 'can0') -> None: ...
    def connect_pipe(self, filename) -> None: ...
    def connect_uart(self, serialport, baud, rts: bool = True) -> None: ...
    def connect_file(self, debugoutput, dictionary, pace: bool = False) -> None: ...
    def set_clock_est(self, freq, conv_time, conv_clock, last_clock) -> None: ...
    def disconnect(self) -> None: ...
    def stats(self, eventtime): ...
    def get_reactor(self): ...
    def get_msgparser(self): ...
    def get_serialqueue(self): ...
    def get_default_command_queue(self): ...
    def register_response(self, callback, name, oid=None) -> None: ...
    def raw_send(self, cmd, minclock, reqclock, cmd_queue) -> None: ...
    def raw_send_wait_ack(self, cmd, minclock, reqclock, cmd_queue): ...
    def send(self, msg, minclock: int = 0, reqclock: int = 0) -> None: ...
    def send_with_response(self, msg, response): ...
    def alloc_command_queue(self): ...
    def dump_debug(self): ...
    def _handle_unknown_init(self, params) -> None: ...
    def handle_unknown(self, params) -> None: ...
    def handle_output(self, params) -> None: ...
    def handle_default(self, params) -> None: ...

class SerialRetryCommand:
    serial: Incomplete
    name: Incomplete
    oid: Incomplete
    last_params: Incomplete
    def __init__(self, serial, name, oid=None) -> None: ...
    def handle_callback(self, params) -> None: ...
    def get_response(self, cmds, cmd_queue, minclock: int = 0, reqclock: int = 0): ...

def stk500v2_leave(ser, reactor) -> None: ...
def cheetah_reset(serialport, reactor) -> None: ...
def arduino_reset(serialport, reactor) -> None: ...
